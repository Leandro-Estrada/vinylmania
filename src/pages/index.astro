---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Cartelería a medida">
  <section class="hero">
    <h1>Cartelería que se ve desde la calle</h1>
    <p>Pastilla · Corpórea · Lona — hecha a medida para tu negocio</p>
    <a class="btn-wa" href="/contacto">Consultar por WhatsApp</a>
  </section>

  <section class="section">
    <p class="section-eyebrow">Qué hacemos</p>
    <div class="category-grid">
      <a class="category-card" href="/productos?cat=pastilla">
        <h3>Cartelería pastilla</h3>
        <p>3 medidas disponibles</p>
      </a>
      <a class="category-card" href="/productos?cat=corporea">
        <h3>Cartelería corpórea</h3>
        <p>Acrílico, chapa, polifan · con o sin luz</p>
      </a>
      <a class="category-card" href="/productos?cat=lona">
        <h3>Cartelería de lona</h3>
        <p>Frontlight y backlight</p>
      </a>
      <a class="category-card" href="/productos?cat=gorras">
        <h3>Merchandising</h3>
        <p>Gorras, remeras, llaveros y calcomanías</p>
      </a>
    </div>
  </section>
</Layout>

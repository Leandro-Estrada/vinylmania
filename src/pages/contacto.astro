---
import Layout from '../layouts/Layout.astro';
const WHATSAPP_NUMBER = '5493436222000'; // TODO: reemplazar por el número real
const ADDRESS = 'Adolfo Alsina 440, Paraná, Entre Ríos, Argentina';
const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(ADDRESS)}&output=embed`;
---
<Layout title="Contacto">
  <section class="section" style="text-align: center; padding-top: 4rem; padding-bottom: 1.5rem;">
    <p class="section-eyebrow">Hablemos</p>
    <h1 class="section-title">Contacto</h1>
    <p style="color: var(--text-muted); margin-bottom: 32px;">
      Contanos qué cartel necesitás y te respondemos con opciones y presupuesto.
    </p>
    
      class="btn-wa"
      href={`https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent('Hola, quiero cotizar un cartel.')}`}
      target="_blank"
      rel="noopener"
    >
      Escribinos por WhatsApp
    </a>
    <p style="margin-top: 24px;">
      <a href="https://www.instagram.com/vinyl.mania/" target="_blank" rel="noopener" style="color: var(--text-muted);">
        Ver más trabajos en Instagram →
      </a>
    </p>
  </section>

  <section class="section" style="padding-top: 0;">
    <p class="section-eyebrow" style="text-align:center;">Dónde estamos</p>
    <p style="text-align:center; color: var(--text-muted); margin: 0 0 20px;">{ADDRESS}</p>
    <iframe
      class="map-embed"
      src={mapSrc}
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      title="Ubicación de Vinylmania"
    ></iframe>
  </section>
</Layout>
